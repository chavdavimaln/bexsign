{
  "name": "bexsign-server",
  "version": "1.0.0",
  "description": "BexSign Express Backend Server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:status": "node scripts/migrate.js --status",
    "db:snapshot": "node scripts/snapshot-schema.js",
    "db:make": "node scripts/migrate.js --make",
    "bucket:status": "node scripts/docbucket-migrate.js --status",
    "bucket:check": "node scripts/docbucket-migrate.js",
    "bucket:migrate": "node scripts/docbucket-migrate.js --apply",
    "bucket:verify": "node scripts/docbucket-migrate.js --verify --apply",
    "bucket:tidy": "node scripts/docbucket-reorganize.js",
    "bucket:tidy:apply": "node scripts/docbucket-reorganize.js --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@napi-rs/canvas": "^1.0.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.1.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
