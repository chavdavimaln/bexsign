# BexSign API — copy to server/.env and fill in. Never commit the real .env.
# Local development works with the values shown here; the "live" comments say what to change on a server.

# --- Server ---
PORT=5000
# Comma-separated browser origins allowed to call the API. Empty = allow every origin (local only).
# live: CORS_ORIGINS=https://sign.example.com
CORS_ORIGINS=
# Set behind NGINX / a load balancer so the audit trail records the real client IP.
# live: TRUST_PROXY=1
TRUST_PROXY=
# true = this API also serves client/dist, so app and API share one domain (no CORS needed).
# live (single server): SERVE_CLIENT=true
SERVE_CLIENT=
CLIENT_DIST_PATH=

# --- Database (MySQL / MariaDB) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=db_bex_sign
DB_PORT=3306

# --- Links inside emails ---
# Where recipients open signing links. Must be the public address of the app on a live server.
# live: CLIENT_URL=https://sign.example.com
CLIENT_URL=http://localhost:3003

# --- Security ---
# Long random string. Change it on the live server; changing it signs every user out.
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts the credentials saved in Settings > Integrations (falls back to JWT_SECRET).
# Set it once and keep it: changing it means integration secrets must be entered again.
INTEGRATION_SECRET_KEY=
# Public address of this API, used in links sent to integrations (signed PDF / certificate URLs)
# and in the Google / Microsoft redirect URIs shown on the Integrations page.
# live: PUBLIC_API_URL=https://sign.example.com
PUBLIC_API_URL=

# --- Sign in with Google / Microsoft (doc/27-google-microsoft-sign-in.md) ---
# Recommended: enter these in Settings > Integrations instead (encrypted, no restart). Values there win over these.
# Redirect URIs to register: <API address>/api/auth/oauth/google/callback and .../microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (any Microsoft account) | organizations | consumers | your Directory (tenant) ID
MICROSOFT_TENANT=common
# Only when the API is reached under another public address than PUBLIC_API_URL
OAUTH_CALLBACK_BASE_URL=

# --- Add document > Cloud (doc/28-cloud-storage-import.md) ---
# Recommended: Settings > Integrations > Google Drive / Dropbox file import / OneDrive / Box. Values there win.
# Redirect URI per provider: <API address>/api/cloud/<google-drive|dropbox-files|onedrive|box>/callback
# Google Drive falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET, OneDrive to the MICROSOFT_* values.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Name shown as the sender
SMTP_FROM_NAME=BexSign
# true = write every email to server/email_outbox as .eml instead of sending it (testing only)
EMAIL_DRY_RUN=false

# --- Text messages (SMS) ---
# Used by the "SMS" / "Email + SMS" delivery modes and the "SMS OTP" access code.
# Empty SMS_PROVIDER = nothing is texted: every message is written to server/sms_outbox instead.
# twilio | msg91
SMS_PROVIDER=
# Twilio: Account SID, Auth Token and the Twilio number that sends the texts (with country code, e.g. +15005550006)
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
# MSG91: auth key and sender ID
SMS_API_KEY=
SMS_SENDER_ID=
# true = write texts to server/sms_outbox even when a provider is set (testing only)
SMS_DRY_RUN=false

# --- Document storage: the doc bucket (doc/31-doc-bucket.md) ---
# Where uploaded documents, signed PDFs, certificates of completion, avatars and scans are kept.
#   local   this server's own disk, server/uploads - the default, nothing else to set
#   s3      AWS S3 and anything S3-compatible (MinIO, Cloudflare R2, DigitalOcean Spaces, Wasabi)
#   azure   Azure Blob Storage          gcs   Google Cloud Storage
# live (recommended): DOC_BUCKET_PROVIDER=s3 - see doc/32-s3-document-storage-live.md
DOC_BUCKET_PROVIDER=local
# Only for provider=local: another folder than server/uploads (an attached disk, a NAS mount).
DOC_BUCKET_LOCAL_ROOT=

# --- provider=s3 ---
# Needs: npm install @aws-sdk/client-s3 @aws-sdk/s3-request-presigner --prefix server
# The standard AWS_* names work too, so a credentials block can be pasted in as it is.
DOC_BUCKET_NAME=
DOC_BUCKET_REGION=us-east-1
DOC_BUCKET_ACCESS_KEY=
DOC_BUCKET_SECRET_KEY=
# Leave empty for AWS. MinIO / R2 / Spaces / Wasabi: their endpoint, e.g. https://minio.example.com
DOC_BUCKET_ENDPOINT=
# true for MinIO and most self-hosted services (path-style addressing)
DOC_BUCKET_FORCE_PATH_STYLE=
# Set only when the bucket is public or sits behind a CDN, e.g. https://files.example.com
DOC_BUCKET_PUBLIC_URL=

# --- provider=azure ---
# Needs: npm install @azure/storage-blob --prefix server
# DOC_BUCKET_NAME is the container name.
AZURE_STORAGE_CONNECTION_STRING=

# --- provider=gcs ---
# Needs: npm install @google-cloud/storage --prefix server
# DOC_BUCKET_NAME is the bucket name. Leave the key file empty on Google Cloud (the machine's
# own service account is used).
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- how the files are served (any remote provider) ---
# true = keep a copy under server/uploads as well, so the PDF pipeline and repeat downloads do
# not fetch from the bucket every time. Default true. Turn off only when disk space is short.
DOC_BUCKET_LOCAL_CACHE=true
# true = redirect the browser to a signed bucket URL instead of streaming through the API.
# Cheaper and faster; the bucket address becomes visible to the browser. Default false.
DOC_BUCKET_REDIRECT=false
# Seconds a signed link stays valid (default 900 = 15 minutes).
DOC_BUCKET_SIGNED_URL_SECONDS=900
