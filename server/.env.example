# BexSign API — copy to server/.env and fill in. Never commit the real .env.
# Local development works with the values shown here; the "live" comments say what to change on a server.

# --- Server ---
PORT=5000
# Comma-separated browser origins allowed to call the API. Empty = allow every origin (local only).
# live: CORS_ORIGINS=https://sign.example.com
CORS_ORIGINS=
# Set behind NGINX / a load balancer so the audit trail records the real client IP.
# live: TRUST_PROXY=1
TRUST_PROXY=
# true = this API also serves client/dist, so app and API share one domain (no CORS needed).
# live (single server): SERVE_CLIENT=true
SERVE_CLIENT=
CLIENT_DIST_PATH=

# --- Database (MySQL / MariaDB) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=db_bex_sign
DB_PORT=3306

# --- Links inside emails ---
# Where recipients open signing links. Must be the public address of the app on a live server.
# live: CLIENT_URL=https://sign.example.com
CLIENT_URL=http://localhost:3003

# --- Security ---
# Long random string. Change it on the live server; changing it signs every user out.
JWT_SECRET=change-me-to-a-long-random-string

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Name shown as the sender
SMTP_FROM_NAME=BexSign
# true = write every email to server/email_outbox as .eml instead of sending it (testing only)
EMAIL_DRY_RUN=false
