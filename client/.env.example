# BexSign client — copy to client/.env (or client/.env.production) and adjust.
# Vite reads these at BUILD time, so rebuild after changing them.

# Where the API lives.
#   empty + npm run dev    -> http://localhost:5000
#   empty + npm run build  -> the same origin the app is served from (API and app behind one domain)
#   set                    -> that address, e.g. https://api.example.com
VITE_API_URL=

# Dev server port (npm run dev)
VITE_PORT=3003
